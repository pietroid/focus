# Agent environment variables.
# This file is an example; copy it to .env.production (or .env.local) on the Pi.

PORT=3001

# The agent does not read the thread files. The server sends it the prompt and
# the history it needs on every request.

# OpenRouter configuration.
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Web search configuration.
# Recommended: Serper.dev (https://serper.dev) or Brave Search API
# (https://api.search.brave.com). If no key is provided, the agent falls back
# to DuckDuckGo's HTML results page, which is less reliable.
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_BASE_URL=https://google.serper.dev/search

# Google Calendar configuration.
#
# Service account key file: create a service account in Google Cloud Console,
# download the JSON key, share your Google Calendar with the service account
# email, place the key on the Pi at /opt/focus/secrets/focus-calendar-prod.json,
# and point GOOGLE_APPLICATION_CREDENTIALS at the mounted path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/focus-calendar-prod.json
#
# Each person gets their own secondary calendar inside that account, named
# after their first name, created on first use and shared with their address
# so they can open it in Google. The uid-to-calendar map is cached in
# AGENT_DATA_DIR/calendars.json and rebuilt by name if it is lost.
# AGENT_DATA_DIR=/app/data
#
# Assigns a person to a calendar you chose, by their Google address. Pairs of
# email=calendar separated by commas. The calendar is either:
#   - a name, found in the service account's calendar list, or created there
#     with that name and shared with the address if there is none, or
#   - an id (anything with an @), for a calendar another account owns and has
#     shared with the service account email. It is added to the service
#     account's list on first use, so it can be named from then on.
# An assignment beats the per-person calendar Focus would have made. People
# not listed keep that behaviour. Read once, so restart the agent after
# changing it.
# GOOGLE_CALENDAR_MAP=pietro@example.com=Pietro,ana@example.com=abc123@group.calendar.google.com
#
# Set this to put everybody on one named calendar instead, which is the
# single-person deployment. It wins over everything above.
# GOOGLE_CALENDAR_ID=primary

# Generic third-party API integration (used by the api_call tool).
API_INTEGRATION_BASE_URL=
API_INTEGRATION_API_KEY=
API_INTEGRATION_READONLY_WHITELIST=

# The zone every hour in Focus is read in. The working day (07:00-22:00), the
# day a block lands on and the time on a card are all wall-clock readings in
# this zone, so on the Pi it must be the zone the user actually lives in.
#
# It also wins over whatever Google says a calendar's own zone is, and the
# calendar is patched to match. Those calendars live inside one service
# account and are created by a container, so the zone Google has on them is
# the container's and not the user's; believing it is how the working day
# started at four in the morning. Leave both unset only if every calendar's
# zone in Google is already right.
# FOCUS_TIMEZONE=America/Sao_Paulo
# TZ=America/Sao_Paulo
