# Agent environment variables.
# This file is an example; copy it to .env.production (or .env.local) on the Pi.

PORT=3001

# The agent does not read the thread files. The server sends it the prompt and
# the history it needs on every request.

# OpenRouter configuration.
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Web search configuration.
# Recommended: Serper.dev (https://serper.dev) or Brave Search API
# (https://api.search.brave.com). If no key is provided, the agent falls back
# to DuckDuckGo's HTML results page, which is less reliable.
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_BASE_URL=https://google.serper.dev/search

# Google Calendar configuration.
#
# Service account key file: create a service account in Google Cloud Console,
# download the JSON key, share your Google Calendar with the service account
# email, place the key on the Pi at /opt/focus/secrets/focus-calendar-prod.json,
# and point GOOGLE_APPLICATION_CREDENTIALS at the mounted path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/focus-calendar-prod.json
#
# The calendar to read/write. Defaults to the authenticated user's primary
# calendar.
# GOOGLE_CALENDAR_ID=primary

# Generic third-party API integration (used by the api_call tool).
API_INTEGRATION_BASE_URL=
API_INTEGRATION_API_KEY=
API_INTEGRATION_READONLY_WHITELIST=

# Server timezone used for calendar queries. Defaults to UTC.
# The working day (07:00-22:00) and every proposed time are read in this zone,
# so on the Pi this should be the zone the user actually lives in.
# TZ=America/Sao_Paulo
