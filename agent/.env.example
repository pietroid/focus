# Agent environment variables.
# This file is an example; copy it to .env.production (or .env.local) on the Pi.

PORT=3001

# Directory where thread markdown files are mounted (read-only).
FOCUS_DATA_DIR=/app/data/threads

# OpenRouter configuration.
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Web search configuration.
# Recommended: Serper.dev (https://serper.dev) or Brave Search API
# (https://api.search.brave.com). If no key is provided, the agent falls back
# to DuckDuckGo's HTML results page, which is less reliable.
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_BASE_URL=https://google.serper.dev/search

# Google Calendar configuration.
#
# Option A: Service account.
#   1. Create a service account in Google Cloud Console.
#   2. Download the JSON key.
#   3. Share your Google Calendar with the service account email.
#   4. Set either the raw JSON or the path to the key file.
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=/path/to/service-account.json
#
# Option B: OAuth2 refresh token.
#   1. Create OAuth2 credentials in Google Cloud Console.
#   2. Run an auth flow to obtain a refresh token.
#   3. Set the refresh token and client credentials.
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
#
# The calendar to read/write. Defaults to the authenticated user's primary
# calendar.
# GOOGLE_CALENDAR_ID=primary

# Generic third-party API integration (used by the api_call tool).
API_INTEGRATION_BASE_URL=
API_INTEGRATION_API_KEY=
API_INTEGRATION_READONLY_WHITELIST=

# Server timezone used for calendar queries. Defaults to UTC.
# TZ=America/Sao_Paulo
